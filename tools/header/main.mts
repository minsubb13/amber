// Last step of `npm run build`: tsc emits "use strict" as the first line of
// each compiled file, so this step puts the generated-file header above it,
// naming the source to edit. Running it again leaves the files unchanged.

import { readdirSync, readFileSync, writeFileSync } from 'node:fs';
import { join, relative, resolve } from 'node:path';

const REPO = resolve(import.meta.dirname, '..', '..', '..');
const SRC = join(REPO, 'src');
const OUT = join(REPO, 'plugin');
const MARK = '// Generated by `npm run build` from ';

/** The .cts sources under dir, as paths relative to src/. */
function sources(dir: string): string[] {
  return readdirSync(dir, { withFileTypes: true }).flatMap((entry) => {
    const path = join(dir, entry.name);
    if (entry.isDirectory()) return sources(path);
    return entry.name.endsWith('.cts') && !entry.name.endsWith('.d.cts')
      ? [relative(SRC, path)]
      : [];
  });
}

for (const source of sources(SRC)) {
  const output = join(OUT, source.replace(/\.cts$/, '.cjs'));
  const header = `${MARK}src/${source.split('\\').join('/')}; edit that file.`;
  const lines = readFileSync(output, 'utf8').split('\n');
  if (lines[0]?.startsWith(MARK) === true) lines[0] = header;
  else lines.unshift(header);
  writeFileSync(output, lines.join('\n'));
}
